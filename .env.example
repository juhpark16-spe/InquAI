# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)

# OpenAI API (감정 라벨링, 답변 생성)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# DB (개발: SQLite 파일, 배포: postgresql+psycopg://user:pass@host/inquai)
DATABASE_URL=sqlite:///./data/inquai.db

# 로그인 (JWT). 아래 명령으로 만든 긴 무작위 문자열을 넣으세요.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# 개발(http://localhost)에서는 false, 배포(https)에서는 true
COOKIE_SECURE=false

# API 문서(/docs) 공개 여부. 배포할 때는 false
API_DOCS=true

# React 개발 서버 주소 (CORS 허용)
FRONTEND_ORIGINS=http://localhost:5173

# 초기 계정 (python -m backend.database.seed_admin 이 읽음). 시연용 비밀번호를 넣으세요.
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
# 시연 고객(customerNN@example.com) 쇼핑몰 로그인 비밀번호 (연동 시연, 4주차). 비우면 고객 로그인 없이 비회원 문의만
SEED_CUSTOMER_PASSWORD=
# 관리자·상담원 비밀번호 최소 길이 (기본 8). 로컬 시연에서 1234 같은 비밀번호를 쓰려면 4로 낮춤. 배포할 때는 8 이상
PASSWORD_MIN_LENGTH=8

# LangSmith 추적 (선택, backend/core/tracing.py). 서버에서만 켜지고 보내기 전에 이메일·전화번호·주문번호 등을 가림
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=inquai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
