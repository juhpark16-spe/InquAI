# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)

# LLM: openai, gemini, openrouter (서버의 처리 방식 판단·FAQ 답변·초안·표기 재확인)
LLM_PROVIDER=openai
# OpenAI API (감정 라벨링, 답변 생성)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Gemini API (LLM_PROVIDER=gemini 일 때). flash-lite 권장: lite가 아닌 flash는 답 1개에 20초 넘게 걸려 문의 처리 제한(20초)을 넘김
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenRouter (LLM_PROVIDER=openrouter 일 때). 모델 이름은 회사/모델 형식
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini

# DB (개발: SQLite 파일, 배포: postgresql+psycopg://user:pass@host/inquai)
DATABASE_URL=sqlite:///./data/inquai.db

# 로그인 (JWT). 아래 명령으로 만든 긴 무작위 문자열을 넣으세요.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# 개발(http://localhost)에서는 false, 배포(https)에서는 true
COOKIE_SECURE=false

# API 문서(/docs) 공개 여부. 배포할 때는 false
API_DOCS=true

# React 개발 서버 주소 (CORS 허용)
FRONTEND_ORIGINS=http://localhost:5173

# 초기 계정 (python -m backend.database.seed_admin 이 읽음). 시연용 비밀번호를 넣으세요.
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
# 시연 고객(customerNN@example.com) 쇼핑몰 로그인 비밀번호 (연동 시연, 4주차). 비우면 고객 로그인 없이 비회원 문의만
SEED_CUSTOMER_PASSWORD=
# 관리자·상담원 비밀번호 최소 길이 (기본 8). 로컬 시연에서 1234 같은 비밀번호를 쓰려면 4로 낮춤. 배포할 때는 8 이상
PASSWORD_MIN_LENGTH=8

# 환불 계좌(예금주·계좌번호) 암호화 열쇠. 비우면 JWT_SECRET_KEY 에서 만들어 씀.
# 따로 두려면 아래 명령으로 만든 값을 넣으세요.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REFUND_ACCOUNT_KEY=
# 열쇠를 바꿀 때: 새 열쇠는 위에, 예전 열쇠는 아래에 (쉼표로 여러 개). 서버를 켜면 예전 열쇠로 잠긴 계좌를 새 열쇠로
# 다시 잠그므로, 그 뒤에는 아래 값을 지워도 됩니다. (JWT_SECRET_KEY 에서 만든 열쇠는 따로 적지 않아도 늘 함께 씀)
REFUND_ACCOUNT_OLD_KEYS=

# 고객 답변 알림 메일 (선택, backend/services/notify.py). false 면 보내지 않고 기록만 (기본)
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=내주소@gmail.com,
#          SMTP_PASSWORD=앱 비밀번호 16자리 (Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호. 계정 비밀번호 아님)
#   설정 확인: python -m backend.services.notify --test 받을주소
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# 시연용: 모든 답변 알림을 이 주소 하나로 보냄 (시연 고객 주소 customerNN@example.com 은 실제로 받을 수 없음)
MAIL_REDIRECT_TO=
# 메일 속 '문의 조회' 링크 주소
SHOP_URL=http://localhost:5173

# LangSmith 추적 (선택, backend/core/tracing.py). 서버에서만 켜지고 보내기 전에 이메일·전화번호·주문번호 등을 가림
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=inquai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
