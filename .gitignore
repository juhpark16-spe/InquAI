.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.env

# AI Hub 원본·정제 데이터 (이용 약관상 재배포 금지)
data/raw/
data/processed/

# 학습된 모델·체크포인트 (용량이 큼)
models/

# 외부 테스트(AI Hub 소상공인 데이터)와, 그 문장이 오답 목록에 들어 있는 평가 보고서
data/test/external_test.csv
evaluation/*external*
evaluation/cur_c4ext*

# 리뷰 데이터를 섞은 실험용 파일 (AI Hub 감정분석 데이터)
data/raw/inquiries_sentiment_reviews.csv

# 개발용 SQLite DB
data/inquai.db*

# 고객이 올린 첨부 사진 (개인정보 포함 가능)
data/uploads/

# 시연 DB를 다시 만들 때 남기는 백업 (개인정보가 섞인 이전 개발 DB·사진)
data/backups/

# 상담원이 고친 분류를 내보낸 재학습 CSV (고객 문의 원문 포함)
data/corrections/

# FAQ 검색 벡터 저장소 (ChromaDB, 서버를 켤 때 FAQ로 다시 만듦)
data/chroma/

# CI가 만드는 설치 목록 (requirements.txt에서 자동 생성)
requirements-ci.txt
requirements-audit.txt

# 화면 자동 테스트 결과 (Playwright)
frontend/test-results/
frontend/playwright-report/
